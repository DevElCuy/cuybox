{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.hg/**",
      "**/.svn/**",

      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/coverage/**",
      "**/htmlcov/**",
      "**/.cache/**",
      "**/.tmp/**",
      "**/tmp/**",
      "**/temp/**",
      "**/logs/**",
      "**/*.log",

      "**/node_modules/**",
      "**/.next/**",
      "**/.nuxt/**",
      "**/.output/**",
      "**/.svelte-kit/**",
      "**/.astro/**",
      "**/.turbo/**",
      "**/.parcel-cache/**",
      "**/.vite/**",
      "**/.yarn/cache/**",
      "**/package-lock.json",
      "**/npm-shrinkwrap.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/bun.lock",
      "**/bun.lockb",

      "**/target/**",
      "**/.gradle/**",
      "**/gradle/dependency-locks/**",
      "**/gradle.lockfile",
      "**/*.class",
      "**/*.jar",
      "**/*.war",
      "**/*.ear",

      "**/CMakeFiles/**",
      "**/CMakeCache.txt",
      "**/cmake-build-*/**",
      "**/vcpkg_installed/**",
      "**/conan.lock",
      "**/*.o",
      "**/*.obj",
      "**/*.a",
      "**/*.so",
      "**/*.so.*",
      "**/*.dylib",
      "**/*.dll",
      "**/*.exe",
      "**/*.pdb",

      "**/Cargo.lock",

      "**/vendor/**",
      "**/*.test",
      "**/coverage.out",
      "**/go.sum",
      "**/go.work.sum",

      "**/_build/**",
      "**/deps/**",
      "**/ebin/**",
      "**/.rebar3/**",
      "**/erl_crash.dump",
      "**/rebar.lock",
      "**/mix.lock",

      "**/__pycache__/**",
      "**/*.py[cod]",
      "**/.venv/**",
      "**/venv/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/.tox/**",
      "**/.nox/**",
      "**/*.egg-info/**",
      "**/poetry.lock",
      "**/Pipfile.lock",
      "**/uv.lock",

      "**/bin/Debug/**",
      "**/bin/Release/**",
      "**/obj/**",
      "**/.vs/**",
      "**/packages.lock.json",

      "**/composer.lock",
      "**/.bundle/**",
      "**/Gemfile.lock",

      "**/.build/**",
      "**/DerivedData/**",
      "**/Package.resolved",

      "**/.dart_tool/**",
      "**/.pub-cache/**",
      "**/pubspec.lock",

      "**/.cxx/**",
      "**/.bloop/**",
      "**/.metals/**",
      "**/.scala-build/**",
      "**/.bsp/**",
      "**/.cpcache/**",
      "**/.stack-work/**",
      "**/dist-newstyle/**",
      "**/cabal.project.freeze",
      "**/stack.yaml.lock",
      "**/zig-out/**",
      "**/.zig-cache/**",
      "**/_opam/**",
      "**/.idea/**",
      "**/.DS_Store",
      "**/Thumbs.db"
    ]
  }
}
