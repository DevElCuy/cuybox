#!/bin/bash
set -euo pipefail

CATALOG_DIR="${CUYBOX_CATALOG_DIR:-/usr/local/lib/cuybox/tools}"

show_help() {
    cat <<'EOF'
Usage: cuybox-install [list]
       cuybox-install install NAME [ARGS...]

List and install optional tools in the current cuybox sandbox.

COMMANDS:
  list                   List all available installers (default when no command is given)
  install NAME [ARGS...] Run the installer named NAME
EOF
}

error_exit() {
    echo "Error: $*" >&2
    exit 1
}

installer_description() {
    local installer="$1"
    local description

    if description=$("$installer" --description 2>/dev/null) && [ -n "$description" ]; then
        printf '%s\n' "$description"
    else
        printf '%s\n' '(no description)'
    fi
}

list_installers() {
    local installer name description count

    printf '%-28s %s\n' "NAME" "DESCRIPTION"
    count=0

    if [ -d "$CATALOG_DIR" ]; then
        for installer in "$CATALOG_DIR"/*.sh; do
            [ -f "$installer" ] || continue
            name=$(basename "$installer" .sh)
            description=$(installer_description "$installer")
            printf '%-28s %s\n' "$name" "$description"
            count=$((count + 1))
        done
    fi

    if [ "$count" -eq 0 ]; then
        echo "No optional tool installers are available."
    fi
}

resolve_installer() {
    local requested_name="$1"
    local candidate

    if [[ ! "$requested_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
        error_exit "invalid installer name '$requested_name'."
    fi

    candidate="$CATALOG_DIR/$requested_name.sh"
    if [ ! -f "$candidate" ]; then
        error_exit "no installer named '$requested_name'. Run 'cuybox-install list' to see available items."
    fi

    if [ ! -x "$candidate" ]; then
        error_exit "installer '$requested_name' is not executable."
    fi

    printf '%s\n' "$candidate"
}

install_item() {
    local requested_name="${1:-}"
    local installer

    [ -n "$requested_name" ] || error_exit "install requires a name. Run 'cuybox-install list' to see available items."
    shift
    installer=$(resolve_installer "$requested_name")
    "$installer" "$@"
}

case "${1:-list}" in
    list|--list|-l)
        shift || true
        [ "$#" -eq 0 ] || error_exit "list does not accept arguments."
        list_installers
        ;;
    install)
        shift
        install_item "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        error_exit "unknown command '$1'. Run 'cuybox-install --help' for usage."
        ;;
esac
